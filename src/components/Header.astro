---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, PHONE_DISPLAY, PHONE_TEL } from '../consts';
---

<header class="site-header">
	<div class="header-inner">
		<a class="logo" href="/">{SITE_TITLE}</a>
		<nav class="nav" aria-label="Primary">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</nav>
		<div class="header-actions">
			<a class="phone" href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a>
			<a class="cta" href="#search-rentals">Search rentals</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--brand-surface);
		border-bottom: 1px solid var(--brand-border);
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
	}

	.header-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.85rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.logo {
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--brand-ink);
		text-decoration: none;
	}

	.logo:hover {
		color: var(--brand-ink);
		text-decoration: none;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		flex: 1;
		justify-content: center;
	}

	.nav :global(a) {
		padding: 0.5rem 0.75rem;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--brand-ink);
		border-bottom: 2px solid transparent;
		text-decoration: none;
	}

	.nav :global(a:hover),
	.nav :global(a.active) {
		border-bottom-color: var(--brand-ink);
		color: var(--brand-ink);
		text-decoration: none;
	}

	.nav :global(a.active) {
		font-weight: 700;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.phone {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--brand-muted);
		text-decoration: none;
		white-space: nowrap;
	}

	.phone:hover {
		color: var(--brand-ink);
	}

	.cta {
		display: inline-block;
		padding: 0.55rem 1rem;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #fff;
		background: var(--brand-cta);
		text-decoration: none;
		border-radius: 2px;
		white-space: nowrap;
	}

	.cta:hover {
		background: var(--brand-cta-hover);
		color: #fff;
		text-decoration: none;
	}

	@media (max-width: 900px) {
		.header-inner {
			justify-content: center;
		}

		.nav {
			order: 3;
			width: 100%;
			justify-content: center;
			flex-wrap: wrap;
		}

		.phone {
			display: none;
		}
	}
</style>
