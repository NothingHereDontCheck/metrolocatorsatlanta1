---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">
		<p class="footer-copy">
			&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
		</p>
		<p class="footer-note">
			Apartment locating in the Atlanta metro. No charge to renters—our fee is paid by participating
			communities.
		</p>
	</div>
</footer>

<style>
	.site-footer {
		background: #2b2b2b;
		color: rgba(255, 255, 255, 0.82);
		padding: 2.5rem 1.25rem;
		text-align: center;
		font-size: 0.875rem;
	}

	.footer-inner {
		max-width: 720px;
		margin: 0 auto;
	}

	.footer-copy {
		margin: 0 0 0.5rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.footer-note {
		margin: 0;
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.8125rem;
	}
</style>
