---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_TAGLINE, PHONE_TEL } from '../consts';

const areas = [
	{
		title: 'Midtown',
		href: '#search-rentals',
		image: '/blog-placeholder-1.jpg',
	},
	{
		title: 'Buckhead',
		href: '#search-rentals',
		image: '/blog-placeholder-2.jpg',
	},
	{
		title: 'Decatur',
		href: '#search-rentals',
		image: '/blog-placeholder-3.jpg',
	},
	{
		title: 'Sandy Springs',
		href: '#search-rentals',
		image: '/blog-placeholder-4.jpg',
	},
];

const featured = [
	{
		title: 'Luxury high-rise near the BeltLine',
		meta: '2 bed · 2 bath · From $2,400',
		image: '/blog-placeholder-1.jpg',
	},
	{
		title: 'Walkable Buckhead community',
		meta: '1 bed · 1 bath · From $1,850',
		image: '/blog-placeholder-2.jpg',
	},
	{
		title: 'Pet-friendly Decatur flats',
		meta: 'Studio · 1 bath · From $1,395',
		image: '/blog-placeholder-3.jpg',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/blog-placeholder-1.jpg" />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero" style="--hero-image: url(/blog-placeholder-about.jpg);">
				<div class="hero-content">
					<p class="hero-kicker">{SITE_TAGLINE}</p>
					<h1 class="hero-title">Apartment locating that saves you time—and points you to the right lease.</h1>
					<p class="hero-lead">
						Metro Locators helps you search, compare, and tour rentals across Atlanta. Tell us your
						must-haves and move date; we shortlist communities and walk you through every step until
						you sign.
					</p>
					<div class="hero-cta-row">
						<a class="btn-primary" id="search-rentals" href="#featured-listings">Browse rental listings</a>
						<a class="btn-ghost" href="/about">How locating works</a>
					</div>
				</div>
			</section>

			<section class="section areas" aria-labelledby="areas-heading">
				<div class="section-inner">
					<h2 id="areas-heading" class="section-title">Locate by neighborhood</h2>
					<p class="section-sub">
						Apartment locating starts where you want to live—we’ll build your list from there.
					</p>
					<div class="area-grid">
						{
							areas.map((a) => (
								<a class="area-card" href={a.href}>
									<img src={a.image} alt="" width="600" height="400" loading="lazy" />
									<span class="area-label">{a.title}</span>
								</a>
							))
						}
					</div>
				</div>
			</section>

			<section class="section featured" id="featured-listings" aria-labelledby="featured-heading">
				<div class="section-inner">
					<div class="featured-head">
						<h2 id="featured-heading" class="section-title">Featured listings</h2>
						<a class="text-link" href="#search-rentals">View all rentals</a>
					</div>
					<p class="section-sub featured-sub">
						Sample rentals we’ve helped clients tour—ask us for a custom apartment locating list
						today.
					</p>
					<div class="featured-grid">
						{
							featured.map((f) => (
								<article class="listing-card">
									<img src={f.image} alt="" width="600" height="380" loading="lazy" />
									<div class="listing-body">
										<h3 class="listing-title">{f.title}</h3>
										<p class="listing-meta">{f.meta}</p>
									</div>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="section cta-band" aria-labelledby="cta-heading">
				<div class="section-inner cta-inner">
					<h2 id="cta-heading" class="cta-heading">Start your apartment locating search</h2>
					<p class="cta-copy">
						Call Metro Locators with your budget and move-in window—we’ll line up tours and answer
						questions before you apply.
					</p>
					<a class="btn-primary" href={`tel:${PHONE_TEL}`}>Call Metro Locators</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		position: relative;
		min-height: min(78vh, 640px);
		display: flex;
		align-items: center;
		justify-content: center;
		background:
			linear-gradient(var(--brand-hero-overlay), var(--brand-hero-overlay)),
			var(--hero-image) center / cover no-repeat;
		color: #fff;
		text-align: center;
		padding: 4rem 1.25rem;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 820px;
	}

	.hero-kicker {
		margin: 0 0 0.75rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		opacity: 0.92;
	}

	.hero-title {
		margin: 0 0 1rem;
		font-size: clamp(1.85rem, 4vw, 2.65rem);
		font-weight: 700;
		line-height: 1.15;
		color: #fff;
		letter-spacing: -0.03em;
	}

	.hero-lead {
		margin: 0 0 1.75rem;
		font-size: 1.05rem;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.92);
		max-width: 52ch;
		margin-left: auto;
		margin-right: auto;
	}

	.hero-cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		align-items: center;
	}

	.btn-primary {
		display: inline-block;
		padding: 0.95rem 1.75rem;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #fff;
		background: var(--brand-cta);
		text-decoration: none;
		border-radius: 2px;
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.btn-primary:hover {
		background: #fff;
		color: var(--brand-ink);
		text-decoration: none;
	}

	.btn-ghost {
		display: inline-block;
		padding: 0.95rem 1.5rem;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #fff;
		background: transparent;
		text-decoration: none;
		border-radius: 2px;
		border: 1px solid rgba(255, 255, 255, 0.45);
	}

	.btn-ghost:hover {
		background: rgba(255, 255, 255, 0.12);
		text-decoration: none;
		color: #fff;
	}

	.section {
		padding: 3.5rem 1.25rem;
	}

	.section-inner {
		max-width: 1120px;
		margin: 0 auto;
	}

	.section-title {
		text-align: center;
		font-size: clamp(1.5rem, 2.5vw, 1.85rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-bottom: 0.5rem;
	}

	.section-sub {
		text-align: center;
		color: var(--brand-muted);
		max-width: 560px;
		margin: 0 auto 2rem;
		font-size: 0.98rem;
	}

	.areas {
		background: var(--brand-bg);
	}

	.area-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	.area-card {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: 4px;
		aspect-ratio: 4 / 3;
		box-shadow: var(--box-shadow);
		text-decoration: none;
	}

	.area-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 4px;
		transition: transform 0.35s ease;
	}

	.area-card:hover img {
		transform: scale(1.04);
	}

	.area-label {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 0.85rem 1rem;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.featured {
		background: var(--brand-surface);
		border-top: 1px solid var(--brand-border);
		border-bottom: 1px solid var(--brand-border);
	}

	.featured-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 0.25rem;
	}

	.featured-sub {
		margin-bottom: 2rem;
	}

	.text-link {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--brand-cta);
		border-bottom: 1px solid currentColor;
	}

	.text-link:hover {
		color: var(--brand-cta-hover);
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.listing-card {
		background: var(--brand-surface);
		border-radius: 4px;
		overflow: hidden;
		border: 1px solid var(--brand-border);
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
	}

	.listing-card img {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		display: block;
		border-radius: 0;
	}

	.listing-body {
		padding: 1.1rem 1.15rem 1.25rem;
	}

	.listing-title {
		font-size: 1rem;
		font-weight: 600;
		margin: 0 0 0.35rem;
		line-height: 1.35;
	}

	.listing-meta {
		margin: 0;
		font-size: 0.8125rem;
		color: var(--brand-muted);
	}

	.cta-band {
		background: var(--brand-bg);
		text-align: center;
	}

	.cta-inner {
		max-width: 640px;
	}

	.cta-heading {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.cta-copy {
		margin: 0 0 1.5rem;
		color: var(--brand-muted);
	}

	.cta-band .btn-primary {
		border: none;
	}

	@media (max-width: 960px) {
		.area-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.featured-grid {
			grid-template-columns: 1fr;
			max-width: 480px;
			margin: 0 auto;
		}
	}

	@media (max-width: 520px) {
		.area-grid {
			grid-template-columns: 1fr;
		}

		.hero-lead {
			font-size: 0.95rem;
		}
	}
</style>
